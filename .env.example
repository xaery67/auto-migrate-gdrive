# Salin file ini menjadi ".env" lalu isi token GitHub Anda.
# File ".env" sudah masuk .gitignore -> TIDAK akan ikut ter-commit.
#
# Token butuh izin "Contents: write" (fine-grained) atau scope "repo" (classic)
# agar bisa push ke repository.
#
# Cara pakai: cukup isi GITHUB_TOKEN di bawah, jangan ubah nama variabelnya.

GITHUB_TOKEN=isi_token_anda_di_sini
GITHUB_USER=xaery67
